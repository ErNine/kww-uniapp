# Client API base（Xasuma /app 场景）
# 联调：先启动 kww-server（cursor/kww-backend-modules-b3dd）
#   bash scripts/demo-sqlite-up.sh && php artisan serve --host=127.0.0.1 --port=8000
VITE_API_BASE_URL=http://127.0.0.1:8000/app

# 接口不可用时是否降级到本地页面 mock 数据（登录接口除外）
VITE_ENABLE_MOCK_FALLBACK=true

# 大厅/私信轮询间隔 ms
VITE_HALL_POLL_INTERVAL_MS=8000

# --- 联调步骤 ---
# 1. 后端 demo-sqlite-up + serve
# 2. 本仓库 yarn / npm 安装依赖后：yarn dev:mp-weixin（或 dev:h5）
# 3. 打开登录页：点「普通用户」或「坑位商」
# 4. 微信合法域名最后由你验证时再配；开发工具可勾选不校验合法域名
