# Client API base（Xasuma /app 场景）
# 联调前置（kww-server main）：
#   composer install
#   php artisan kww:install --sqlite --force
#   php artisan serve --host=127.0.0.1 --port=8000
# 兼容：bash scripts/demo-sqlite-up.sh
VITE_API_BASE_URL=http://127.0.0.1:8000/app

# 接口不可用时是否降级到本地页面 mock 数据（登录接口除外）
VITE_ENABLE_MOCK_FALLBACK=true

# 大厅/私信轮询间隔 ms
VITE_HALL_POLL_INTERVAL_MS=8000

# --- 前端启动 ---
# npm ci && npm run dev:mp-weixin   # 或 npm run dev:h5
# 微信开发者工具打开 dist/dev/mp-weixin，勾选「不校验合法域名」
# 登录页选「普通用户」/「坑位商」；「我的」可切换身份
